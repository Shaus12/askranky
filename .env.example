# Brand (single place; also defaults in src/brand.js)
BRAND_NAME=Ranky
BRAND_DOMAIN=askranky.com
SUPPORT_EMAIL=shaysho1111@gmail.com
LEGAL_ENTITY=
BASE_URL=http://localhost:3000
# Scans: mock (default) or live. Missing key for an engine => that engine stays mock.
SCAN_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
PERPLEXITY_API_KEY=
PERPLEXITY_URL=https://api.perplexity.ai/v1/responses
DAILY_SPEND_CAP_USD=10
# Payments: mock (default) or sumit
PAYMENTS_PROVIDER=mock
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
SUMIT_PUBLIC_API_KEY=  # PUBLIC key (sent to the browser for the embedded card form); never the private SUMIT_API_KEY
SUMIT_WEBHOOK_SECRET=
# Email: mock writes data/outbox/*.html; live uses Resend
EMAIL_MODE=mock
RESEND_API_KEY=
# Sender must be on a domain verified in Resend (askranky.com; NOT send.askranky.com). Plain address or "Name <address>".
EMAIL_FROM=Ranky <hello@askranky.com>
EMAIL_REPLY_TO=shaysho1111@gmail.com

# Runtime data (db.json, mock email outbox). Tests use a temp dir.
DATA_DIR=./data

# Read-only ops status endpoint: GET /api/internal/status with header X-Status-Token. Needs >= 24 chars (openssl rand -hex 32); unset = disabled (404).
STATUS_TOKEN=

# Scan follow-up email (POST /api/internal/cron/followup, CRON_SECRET header). Off unless exactly 1. Not scheduled.
FOLLOWUP_EMAILS_ENABLED=
# Optional offer line in the follow-up (default empty = no offer). Only set once billing can really charge it.
FOLLOWUP_OFFER_TEXT_HE=
FOLLOWUP_OFFER_TEXT_EN=

# Alerts (src/alerts.js): POST /api/internal/cron/alerts re-scans paid businesses older than ALERT_SCAN_DAYS and emails what got worse.
# Off unless 1 (re-scans cost AI credits; budget caps still apply). Trigger it from your external cron like the sync job.
ALERTS_ENABLED=
ALERT_SCAN_DAYS=7

# Scheduled re-scans (src/rescan.js): POST /api/internal/cron/rescan (CRON_SECRET header), trigger DAILY from the external cron; only due
# businesses are scanned: Starter every 30 days, Pro/Agency every 7 days, ACTIVE subscriptions only, never comp accounts.
# Off unless exactly 1 (AI cost; plan + daily caps still apply). While off, plan cards say "automatic scheduling coming soon".
AUTO_RESCAN_ENABLED=
AUTO_RESCAN_MAX_PER_RUN=50
# Monthly digest email (src/digest.js): POST /api/internal/cron/digest. Paying customers only, max one per calendar month, no scans.
# Off unless exactly 1. While off, plan cards say the monthly summary is "coming soon".
MONTHLY_DIGEST_ENABLED=
# One-time Fix-up (₪390, src/plans.js PRODUCTS): its full scan + 30-day re-scan run via POST /api/internal/cron/fixup.
# Off unless exactly 1 (AI cost, ~2 x 20 questions x 2 engines per order). While off, a person runs them (dashboard re-scan is plan-capped).
FIXUP_SCANS_ENABLED=
